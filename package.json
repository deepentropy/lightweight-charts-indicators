{
  "name": "lightweight-charts-indicators",
  "version": "0.24.0",
  "type": "module",
  "description": "1869 technical analysis indicators for the lightweight-charts library",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render.mjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.mjs"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader/loader.js"
    },
    "./about": {
      "types": "./dist/about.d.ts",
      "import": "./dist/about.mjs"
    }
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run clean && node scripts/build-loader.mjs && npm run build:esm && npm run build:cjs && npm run build:render && npm run build:helpers && npm run build:types && npm run build:sources && npm run build:loader && npm run build:about",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --platform=neutral --external:oakscriptjs --external:oakscriptjs/* --external:@types/*",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.cjs --platform=neutral --external:oakscriptjs --external:oakscriptjs/* --external:@types/*",
    "build:render": "esbuild src/render/index.ts --bundle --format=esm --outfile=dist/render.mjs --platform=neutral --external:oakscriptjs --external:oakscriptjs/* --external:lightweight-charts --external:fancy-canvas --external:@types/*",
    "build:helpers": "esbuild src/helpers.ts --bundle --format=esm --outfile=dist/helpers.mjs --platform=neutral --external:oakscriptjs --external:oakscriptjs/* --external:@types/*",
    "build:sources": "node scripts/build-sources.mjs",
    "build:loader": "esbuild src/loader.ts --bundle --splitting --format=esm --outdir=dist/loader --chunk-names=chunks/[name]-[hash] --platform=neutral --external:oakscriptjs --external:oakscriptjs/* --external:@types/*",
    "build:about": "node scripts/build-about.mjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:example": "vite build",
    "dev:example": "vite",
    "clean": "rimraf dist dist-example",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.skills.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pinesuite": "vitest run --config vitest.regression.config.ts",
    "test:reference": "vitest run --config vitest.reference.config.ts"
  },
  "keywords": [
    "lightweight-charts",
    "pinescript",
    "trading",
    "technical-analysis",
    "indicators",
    "oakscript",
    "ta",
    "finance"
  ],
  "author": "Odyssée",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepentropy/lightweight-charts-indicators.git"
  },
  "bugs": {
    "url": "https://github.com/deepentropy/lightweight-charts-indicators/issues"
  },
  "homepage": "https://github.com/deepentropy/lightweight-charts-indicators#readme",
  "peerDependencies": {
    "lightweight-charts": ">=5.2.0 <6.0.0",
    "oakscriptjs": ">=0.16.0 <0.18.0"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "esbuild": "^0.19.11",
    "lightweight-charts": "^5.2.1",
    "oakscriptjs": "^0.17.0",
    "rimraf": "^6.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
